---
import ThemeToggle from './ThemeToggle.astro';

const GITHUB_URL = 'https://github.com/latechlogan';
const LINKEDIN_URL = 'https://www.linkedin.com/in/logan-baugh/';

---

<header>
	<nav aria-label="Main">
		<a class="brand" href="/">Logan Baugh</a>
		<ul>
			<!-- Path-qualified so these still resolve from /work/* pages; on the
			     home page the browser treats them as plain in-page fragment jumps. -->
			<li><a href="/#about">About</a></li>
			<li><a href="/#projects">Projects</a></li>
			<li><a href="/JonathanLoganBaugh_Resume.pdf" target="_blank" rel="noopener">Resume</a></li>
			<li><a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a></li>
			<li><a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a></li>
		</ul>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		/* Same column as every section (see .section in index.astro) so the
		   brand lines up with the hero headline instead of floating left of it. */
		max-width: calc(var(--measure) + var(--space-4) * 2);
		margin-inline: auto;
		padding: var(--space-4);
	}

	/* Mobile first: two tidy rows — brand and theme toggle on top (the
	   auto margin pushes the toggle right), links as a full-width second
	   row. Left to wrap on its own, the nav fell into three ragged rows
	   with the toggle alone at the bottom. */
	.brand {
		font-weight: 500;
		color: var(--text-primary);
		text-decoration: none;
		margin-right: auto;
	}

	ul {
		order: 1; /* after the toggle, onto its own row */
		flex-basis: 100%;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	/* One row once it fits: brand + links + toggle measure ~510px with
	   padding; 540px leaves breathing room before the toggle. */
	@media (min-width: 540px) {
		.brand {
			margin-right: 0;
		}

		ul {
			order: 0;
			flex-basis: auto;
			margin: 0 auto 0 0;
		}
	}

	ul a {
		font-size: var(--text-sm);
		color: var(--text-secondary);
		text-decoration: none;
	}

	ul a:hover {
		color: var(--text-primary);
	}

	@media (prefers-reduced-motion: no-preference) {
		ul a {
			transition: color 0.15s ease;
		}
	}
</style>
