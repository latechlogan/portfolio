---
// The headline is split into word spans at build time so the entrance can
// stagger word by word. Each span's --i sets its place in the sequence.
const lead = "Happiest in the space between".split(" ");
const design = "make it beautiful".split(" ");
const andIndex = lead.length + design.length;
const tagline = "Happiest in the space between make it beautiful and make it work";
---

<section class="hero" aria-label="Intro">
	<p class="eyebrow">Design engineer</p>
	<!-- aria-label keeps the sentence whole for screen readers — some
	     (VoiceOver in particular) read inline-block word spans one by one. -->
	<h1 aria-label={tagline}>
		{lead.map((word, i) => <><span class="word" style={`--i: ${i}`}>{word}</span>{" "}</>)}
		<em>{design.map((word, i) => <><span class="word" style={`--i: ${lead.length + i}`}>{word}</span>{i < design.length - 1 && " "}</>)}</em>{" "}
		<span class="word" style={`--i: ${andIndex}`}>and</span>{" "}
		<span class="word" style={`--i: ${andIndex + 1}`}><code>make it work</code></span>
	</h1>
	<p class="support">
		Graphic-design roots and 7+ years building accessible, interactive experiences for the
		web — with an eye for the details most people scroll right past.
	</p>
	<a class="cta" href="#projects">See what I've made</a>
</section>

<style>
	.hero {
		max-width: calc(var(--measure) + var(--space-4) * 2);
		margin-inline: auto;
		padding: var(--space-16) var(--space-4);
	}

	/* The role is the label; the tagline is the headline. */
	.eyebrow {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--text-secondary);
		margin: 0 0 var(--space-4);
	}

	/* Steps between two sizes already in the scale: --text-2xl on narrow
	   screens, where the display size wraps to four lines, and the off-scale
	   display once there's room. */
	h1 {
		font-size: var(--text-2xl);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-tight);
		font-weight: 500;
		text-wrap: balance;
		margin: 0 0 var(--space-6);
	}

	@media (min-width: 500px) {
		h1 {
			font-size: var(--text-display);
			line-height: var(--leading-tight);
		}
	}

	/* The design half: serif, with a coral highlighter stroke across its
	   lower half — the page's one coral moment. box-decoration-break keeps
	   the stroke's padding on every line if the phrase ever wraps. */
	h1 em {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 400;
		padding: 0 0.08em;
		background: linear-gradient(
			transparent 60%,
			var(--coral-tint) 60% 92%,
			transparent 92%
		);
		/* Explicit, not the implicit auto, so the entrance can animate it. */
		background-size: 100% 100%;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	/* The code half: the same mono chip as About's tech terms, sized in em
	   so it scales with whichever size the h1 is at. */
	h1 code {
		font-family: var(--font-mono);
		font-size: 0.8em;
		font-weight: 400;
		letter-spacing: 0;
		background: var(--green-tint);
		color: var(--green-ink);
		padding: 0 0.25em;
		border-radius: var(--radius);
		white-space: nowrap;
	}

	.support {
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		color: var(--text-secondary);
		max-width: var(--measure);
		margin: 0 0 var(--space-8);
	}

	/* Text link, not a button — the inspiration sites (Emil, Rauno, Paco)
	   rarely reach for filled buttons; green underlined text is the CTA voice. */
	.cta {
		display: inline-block;
		font-size: var(--text-base);
		font-weight: 500;
	}

	.cta:active {
		transform: translateY(1px);
	}

	/* inline-block so a word can be transformed; wrapping still happens at
	   the spaces between words, so line breaks are unchanged. */
	.word {
		display: inline-block;
	}

	/* Entrance. CSS rather than Motion because the hero is above the fold:
	   a deferred script would run after first paint and flash the content
	   before hiding it. Keyframes run from the first frame and need no JS,
	   so no-JS and reduced motion both just show everything.

	   Sequence: eyebrow → headline word by word (60ms apart) → highlighter
	   sweeps across once "beautiful" lands → support → CTA. `backwards`
	   holds each element hidden through its delay, then lets go entirely,
	   so nothing overrides the CTA's :active nudge afterward. The curve
	   overshoots slightly — a spring's settle, without a runtime. */
	@media (prefers-reduced-motion: no-preference) {
		.eyebrow,
		.word,
		.support,
		.cta {
			animation: rise 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
		}

		.word {
			animation-delay: calc(100ms + var(--i) * 60ms);
		}

		h1 em {
			background-repeat: no-repeat;
			animation: sweep 0.5s cubic-bezier(0.22, 1, 0.36, 1) 700ms backwards;
		}

		.support {
			animation-delay: 800ms;
		}

		.cta {
			animation-delay: 900ms;
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.35em);
		}
	}

	@keyframes sweep {
		from {
			background-size: 0% 100%;
		}
	}
</style>
