---
import Bubble from "./Bubble.astro";
---

<section id="about" class="about" aria-labelledby="about-heading">
  <h2 id="about-heading">About</h2>

  <div class="thread">
    <Bubble variant="question">So, what's your story?</Bubble>
    <Bubble variant="answer">
      <p>
        I started in graphic design, fell for the web, and learned to code so I
        could build the things I was designing instead of handing them off.
        Seven-plus years later I still do both — that overlap is the whole
        point.
      </p>
    </Bubble>

    <Bubble variant="question">Where'd you spend those years?</Bubble>
    <Bubble variant="answer">
      <p>
        Healthcare, mostly. The kind of work where clarity isn't a style choice
        — real people need to find a doctor or make sense of their coverage, and
        getting it wrong has real consequences.
      </p>
      <p>
        It's where I learned accessibility for real: audited, WCAG-compliant
        work, not a checkbox. "Clean and clear" isn't the safe option to me —
        it's the job.
      </p>
    </Bubble>

    <Bubble variant="question">And lately?</Bubble>
    <Bubble variant="answer">
      <p>
        I've been building end to end. Most recently a voice-controlled math
        game for my kids — shipped in <code>React</code> and
        <code>TypeScript</code>, with a custom native plugin so it runs
        on-device and keeps their audio private.
      </p>
      <p>
        I care most about the seam where design meets code: making things that
        are beautiful <em>and</em> buildable, and sweating the small interactions
        most people feel but never notice.
      </p>
    </Bubble>

    <Bubble variant="question">What are you after?</Bubble>
    <Bubble variant="answer">
      <p>
        A team with a product worth caring about — where design and engineering
        aren't at odds, and the details matter to someone besides me.
      </p>
    </Bubble>
  </div>
</section>

<script>
  import { inView, spring } from "motion";
  import { animate } from "motion/mini";

  // Progressive enhancement: with no JS, or with reduced motion, every
  // bubble is already fully visible via plain CSS — nothing above this
  // point depends on the script running.
  const prefersReducedMotion = matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    const section = document.querySelector("#about");
    const thread = section?.querySelector(".thread");
    const items = thread
      ? (Array.from(thread.children) as HTMLElement[])
      : [];

    if (section && items.length) {
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const pop = { type: spring, stiffness: 260, damping: 26 };

      // What actually fades in. For an answer row it's the card + monogram,
      // not the row itself — the typing overlay lives in the row and has to
      // stay visible while the answer is still "being typed".
      const revealTargets = (item: HTMLElement) => {
        const typing = item.querySelector<HTMLElement>(".typing-slot");
        return typing
          ? Array.from(item.querySelectorAll<HTMLElement>(".bubble, .monogram"))
          : [item];
      };

      // Set the hidden starting state from JS, immediately before wiring
      // up the reveal — CSS never hides this content on its own.
      items.forEach((item) => {
        revealTargets(item).forEach((el) => {
          el.style.opacity = "0";
          el.style.transform = "translateY(12px)";
        });
      });

      // Plays one item. Questions just pop in. Answers first show the typing
      // dots for a beat scaled to the answer's length (a long reply "takes
      // longer to type"), then swap the dots for the card. Resolves once the
      // item's reveal has started, so the next item can follow it.
      const play = async (item: HTMLElement) => {
        const typing = item.querySelector<HTMLElement>(".typing-slot");

        if (typing) {
          const chars = item.textContent?.trim().length ?? 0;
          const hold = Math.min(1000, 400 + chars * 2.5);

          await wait(150);
          typing.hidden = false;
          animate(
            typing,
            { opacity: [0, 1], transform: ["translateY(6px)", "translateY(0px)"] },
            pop,
          );
          await wait(hold);
          animate(typing, { opacity: 0 }, { duration: 0.2 }).finished.then(
            () => {
              typing.hidden = true;
            },
          );
          // Let the dots start fading before the card arrives, so the swap
          // reads as a hand-off rather than a pile-up.
          await wait(100);
        }

        animate(
          revealTargets(item),
          { opacity: 1, transform: "translateY(0px)" },
          pop,
        );
        await wait(120);
      };

      // Shows an item as-is, no choreography — for items the reader has
      // already scrolled past without them ever crossing the viewport.
      const showInstantly = (item: HTMLElement) => {
        revealTargets(item).forEach((el) => {
          el.style.opacity = "";
          el.style.transform = "";
        });
      };

      // A chat happens in order: an answer never lands before its question.
      // inView tells us
      // *which* items are on screen, but the browser delivers those
      // callbacks in no particular order — so rather than playing items as
      // they report in, we mark them ready and always release the lowest
      // unplayed index first (a sequencer). `next` is the cursor.
      const ready = new Set<number>();
      let next = 0;
      let running = false;

      const run = async () => {
        if (running) return;
        running = true;

        while (next < items.length) {
          const item = items[next];

          if (ready.has(next)) {
            await play(item);
            next++;
          } else if (item.getBoundingClientRect().bottom <= 0) {
            // Above the viewport and never seen: the reader jumped past it.
            // Reveal it plainly so the thread reads whole if they scroll up.
            showInstantly(item);
            next++;
          } else {
            // Still below or entering — wait for its inView callback.
            break;
          }
        }

        running = false;
      };

      // The `-12%` margin means an item has to be a bit past the bottom
      // edge before it counts as "in view", not the instant its top pixel
      // appears.
      items.forEach((item, i) => {
        inView(
          item,
          () => {
            ready.add(i);
            run();
          },
          { margin: "0px 0px -12% 0px" },
        );
      });
    }
  }
</script>

<style>
  .about {
    max-width: calc(var(--measure) + var(--space-4) * 2);
    margin-inline: auto;
    padding: var(--space-16) var(--space-4);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0 0 var(--space-8);
  }

  .thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
