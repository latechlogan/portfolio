---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Link {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  title: string;
  tagline: string;
  description: string;
  links: Link[];
  image: ImageMetadata;
}

const { title, tagline, description, links, image } = Astro.props;
---

<li class="project">
  <h3>{title}</h3>
  <p class="tagline">{tagline}</p>
  <p class="description">{description}</p>
  <p class="links">
    {
      links.map((link, i) => (
        <>
          {i > 0 && (
            <span class="sep" aria-hidden="true">
              ·
            </span>
          )}
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener" : undefined}
          >
            {link.label}
          </a>
        </>
      ))
    }
  </p>

  <!-- Decorative: the row's text and links carry everything, so alt is
       empty. Hidden (display: none) unless the device can hover — and a
       lazy image that's display: none is never fetched, so touch devices
       don't pay for it. On hover it follows the pointer (script below). -->
  <Image
    class="thumb"
    src={image}
    alt=""
    widths={[240, 480]}
    sizes="240px"
    loading="lazy"
  />
</li>

<style>
  /* Editorial list row: a hairline above each entry instead of a card. */
  .project {
    border-top: 1px solid var(--border);
    padding-block: var(--space-6);
  }

  h3 {
    font-size: var(--text-lg);
    font-weight: 500;
    margin: 0 0 var(--space-1);
  }

  .tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }

  .description {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }

  .links {
    font-size: var(--text-sm);
    margin: 0;
  }

  .sep {
    display: inline-block;
    margin: 0 var(--space-2);
    color: var(--text-muted);
  }

  .thumb {
    display: none;
  }

  /* Feature detection, not a breakpoint: only devices that can actually
     hover get the thumbnail. The width floor guarantees room for it to the
     right of the cursor anywhere over the text column, so it never needs
     to flip sides or clip at the viewport edge. */
  @media (hover: hover) and (pointer: fine) and (min-width: 1280px) {
    /* Fixed, so the pointer's viewport coordinates map straight onto it;
       the script below writes the transform. */
    .thumb {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 10;
      width: 240px;
      height: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      opacity: 0;
      pointer-events: none;
    }

    /* .is-following is added by the script, so without JS the thumbnail
       never shows up stranded in the corner. */
    .project.is-following:hover .thumb {
      opacity: 1;
    }
  }

  /* Only opacity transitions — a transform transition would make the
     thumbnail trail the cursor instead of staying locked to it. */
  @media (prefers-reduced-motion: no-preference) {
    .thumb {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  // Locks each row's thumbnail to the pointer. CSS decides *whether* it
  // shows (hover + the media query above); this only decides *where*.
  // Offset right of the cursor and centered on it vertically, so it
  // never sits under the pointer.
  const OFFSET_X = 20;

  document.querySelectorAll<HTMLElement>(".project").forEach((project) => {
    const thumb = project.querySelector<HTMLElement>(".thumb");
    if (!thumb) return;

    project.classList.add("is-following");
    project.addEventListener("pointermove", (event) => {
      thumb.style.transform = `translate(${event.clientX + OFFSET_X}px, ${event.clientY}px) translateY(-50%)`;
    });
  });
</script>
